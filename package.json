{
  "name": "salamione",
  "version": "2.0.0",
  "description": "SalamiOne: asesor de CIS Controls v8.1 (IG1, IG2, IG3) con IA propia, dashboard con citas verificadas, exportación PDF/Excel y comparación antes y después.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch-path=server.js --watch-path=src --watch-path=shared --watch-path=config server.js --dev",
    "build": "vite build",
    "prestart": "vite build",
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "samples": "node scripts/samples-pdf.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mammoth": "^1.8.0",
    "motion": "^14.12.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.77.0",
    "pdf-parse": "1.1.1",
    "puppeteer-core": "^25.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.7"
  }
}
