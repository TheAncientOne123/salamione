# ---------- SalamiOne ----------
PORT=3000

# Clave para cifrar las API keys de los usuarios. Fíjala en producción: si cambia, las keys guardadas dejan de leerse.
# Si no se define, se genera una y se guarda en data/.secret.
# APP_SECRET=

# Detrás de un proxy HTTPS (nginx, Caddy, Render, etc.)
# TRUST_PROXY=1
# COOKIE_SECURE=true

# Base de datos (por defecto data/salamione.db)
# DB_FILE=

# ---------- IA del servidor (opcional) ----------
# Se usa para los usuarios que no conectaron su propio modelo. SERVER_AI=false la desactiva.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# SERVER_AI=true

# ---------- Evaluación ----------
# Máximo de caracteres de documentación por llamada y salvaguardas por lote.
MAX_DOC_CHARS=150000
# SAFEGUARD_BATCH=40

# Ruta de Chrome/Edge para generar los PDF (si no se detecta sola).
# CHROME_PATH=
