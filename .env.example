# Clave de la API de OpenAI (https://platform.openai.com/api-keys).
# Sin clave, la app funciona en "modo heurístico" (análisis por palabras clave, sin chat).
OPENAI_API_KEY=

# Modelo a usar (cualquier modelo con soporte de Structured Outputs).
OPENAI_MODEL=gpt-4.1

# Opcional: endpoint compatible con OpenAI (Azure OpenAI, proxy, etc.)
# OPENAI_BASE_URL=

# Máximo de caracteres de documentación que se envían al modelo por análisis.
MAX_DOC_CHARS=150000

PORT=3000

# Opcional: lista de modelos que ofrece el selector de la página (separados por coma).
# OPENAI_MODELS=gpt-4.1,gpt-4.1-mini,gpt-4o,gpt-5,gpt-5-mini

# Opcional: ruta de Chrome/Edge para generar el PDF (si no se detecta solo).
# CHROME_PATH=
